# Copy to `.env.local` to develop against the database on the docker.lan host
# rather than one on this machine:
#
#   cp .env.local.example .env.local
#   npm run db:up:lan
#   npm run db:migrate
#   npm run dev
#
# `.env.local` is read after `.env` and wins, so `.env` stays as it came from
# `.env.example` and this file holds only what differs. It is gitignored; a real
# exported shell variable still beats both.

# The Docker daemon is the docker.lan host, so this is where its published port
# actually lives. `docker context inspect docker.lan` tells you the hostname.
DATABASE_URL=postgres://ephemeris:ephemeris@docker.lan:5437/ephemeris

# Set this to the same value you passed to `npm run db:up:lan` if you gave the
# dev database a real password, and put it in DATABASE_URL above too.
# POSTGRES_PASSWORD=ephemeris

# Only if you are running the API on the docker.lan host as well. `npm run dev`
# runs it locally, so the default is right and this stays commented out.
# EPHEMERIS_SERVER_URL=http://docker.lan:3005
