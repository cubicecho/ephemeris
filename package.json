{
  "name": "ephemeris",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Ephemeris — a minimal daily journal. One entry a day, a mood with it.",
  "type": "module",
  "workspaces": [
    "app",
    "server",
    "db"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:app\"",
    "dev:app": "npm run dev -w @cubicecho/ephemeris-app",
    "dev:server": "npm run dev -w @cubicecho/ephemeris-server",
    "build": "npm run codegen && npm run build -w @cubicecho/ephemeris-app",
    "start": "npm run start -w @cubicecho/ephemeris-server",
    "codegen": "npm run codegen:server && npm run codegen:app",
    "codegen:app": "npm run codegen -w @cubicecho/ephemeris-app",
    "codegen:server": "npm run codegen -w @cubicecho/ephemeris-server",
    "check": "npm run codegen && npm run check:biome && npm run check:types",
    "check:biome": "biome check --write .",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p db/tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p app/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate -w @cubicecho/ephemeris-db",
    "db:migrate": "npm run migrate -w @cubicecho/ephemeris-db",
    "db:push": "npm run push -w @cubicecho/ephemeris-db",
    "db:studio": "npm run studio -w @cubicecho/ephemeris-db",
    "db:up": "DOCKER_CONTEXT=default docker compose -f docker-compose.dev.yml up -d",
    "db:up:lan": "DOCKER_CONTEXT=docker.lan DEV_BIND=0.0.0.0 docker compose -f docker-compose.dev.yml up -d",
    "db:down": "DOCKER_CONTEXT=default docker compose -f docker-compose.dev.yml down",
    "db:down:lan": "DOCKER_CONTEXT=docker.lan docker compose -f docker-compose.dev.yml down"
  },
  "overrides": {
    "graphql": "16.13.2",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.15.2",
    "@biomejs/biome": "2.5.11",
    "@electric-sql/pglite": "^0.3.15",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/client-preset": "^5.2.2",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-resolvers": "^5.1.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.0.0",
    "concurrently": "^9.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4"
  }
}
