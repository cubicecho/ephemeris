# Copy to `.env`. For per-machine overrides that should not be committed (a database on another host, say) add a
# `.env.local` next to it: it is read after this file and wins. See .env.local.example.

# Required. PostgreSQL connection string. `npm run db:up` starts a local one matching this.
DATABASE_URL=postgres://ephemeris:ephemeris@127.0.0.1:5437/ephemeris

# Required. What better-auth signs with: sessions live in Postgres, but the OIDC state cookie and one-time tokens are
# signed. In production the server refuses to start while this is unset, shorter than 32 characters, or still this
# value. Generate one with: openssl rand -hex 32. JWT_SECRET is the older name, and is still read when this is unset.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Public URL the app is served at. Magic links and the OIDC sign-in's landing page are built from it.
# Default http://localhost:PORT. In development, where Vite serves the app on 3000, set it to http://localhost:3000.
# APP_URL=http://localhost:3005

# Where a browser reaches this server, for the OIDC sign-in's start and callback. Defaults to APP_URL in production,
# where they are the same, and to http://localhost:PORT in development. Vite proxies both paths, so in development
# http://localhost:3000 works here too.
# SERVER_URL=http://localhost:3005

# Sign in through an OpenID Connect provider (heautou, Keycloak, Authentik, …).
# The easier way is to leave these unset and paste a setup URL from the provider into the login page: Ephemeris then
# registers itself with the provider (Dynamic Client Registration). Anyone may do that while the instance has no
# accounts; after that only the admin, who is the first account. Set here, the provider wins and cannot be changed
# from the app. Register the redirect URI the server prints at boot: <SERVER_URL>/api/auth/callback/oidc
# OIDC_ISSUER=https://id.example.com/oidc
# OIDC_CLIENT_ID=ephemeris
# Unset for a public client, which proves itself with PKCE alone.
# OIDC_CLIENT_SECRET=
# client_secret_basic (default) or client_secret_post; the provider must agree.
# OIDC_CLIENT_AUTH=client_secret_basic
# What the login page's button calls it. Default: SSO
# OIDC_NAME=heautou

# Port the server listens on. Default 3005.
# PORT=3005

# Longest entry body accepted, in characters. Default 65536 (about 10,000 words).
# MAX_BODY_CHARS=65536

# "true" when nothing hostile can reach this port: entering an address signs you straight in, with no link to fetch.
# Default false. A LAN you control and nowhere else, because it makes the address the entire credential.
# SECURE_LOCAL_NET=false

# The same instruction, narrower: "false" turns off magic-link verification on its own. Default true.
# SECURE_LOCAL_NET=true implies it. Unsafe wherever SECURE_LOCAL_NET is.
# AUTH_MAGIC_LINK=true

# Either of the two above with an APP_URL that is not a private address stops the boot. "true" says that is on
# purpose: something other than the address keeps strangers off this port. Default false.
# I_KNOW_SECURE_LOCAL_NET_IS_PUBLIC=false

# Return the magic link in the API response. Default true outside production, false in it.
# Unsafe on a reachable instance: anyone can sign in as any address.
# EXPOSE_MAGIC_LINK=false

# How long the server waits for Postgres at boot before giving up, in ms. Default 60000.
# DB_CONNECT_TIMEOUT_MS=60000

# Proxies in front of this server that may set X-Forwarded-For. Default false (none).
# "1" for one reverse proxy (Caddy, Traefik, nginx); or "loopback", "uniquelocal", or a list of addresses.
# Sign-in rate limits key on the client address, so get this right behind a proxy.
# Never "true" when the port is reachable from the internet: any client could then choose its own address.
# TRUST_PROXY=1

# Where `npm run dev:app` proxies /graphql. Default http://localhost:3005.
# EPHEMERIS_SERVER_URL=http://localhost:3005

# Address the dev compose file publishes Postgres on. Default 127.0.0.1. `npm run db:up:lan` runs the same file on the
# docker.lan host and sets this to 0.0.0.0, because the loopback a remote daemon binds is that host's.
# Trusted networks only. See .env.local.example for the rest of that setup.
# DEV_BIND=127.0.0.1

# Password for the dev database. Default ephemeris. Worth setting alongside `npm run db:up:lan`, which puts Postgres
# on the LAN.
# POSTGRES_PASSWORD=ephemeris
