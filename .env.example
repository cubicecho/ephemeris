# Copy to `.env`. For per-machine overrides that should not be committed — a
# database on another host, say — add a `.env.local` next to it: it is read
# after this file and wins. See .env.local.example.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string. `npm run db:up` starts a local one matching this.
DATABASE_URL=postgres://ephemeris:ephemeris@127.0.0.1:5437/ephemeris

# Secret used to sign session and magic-link tokens. The server refuses to start
# in production while this is unset or still the default.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ── Optional ──────────────────────────────────────────────────────────────────

# Public URL the app is served at. Magic-link URLs are built from it.
# Defaults to http://localhost:PORT.
# APP_URL=http://localhost:3005

# Port the server listens on. Default: 3005
# PORT=3005

# Longest entry body accepted, in characters. Default: 65536 (~10,000 words)
# MAX_BODY_CHARS=65536

# "true" when nothing hostile can reach this port: entering an address signs you
# straight in, with no link to go and fetch. A LAN you control, and nowhere else,
# because it makes the address the entire credential.
# SECURE_LOCAL_NET=false

# The same instruction, narrower: "false" turns off magic-link verification on
# its own. SECURE_LOCAL_NET=true implies it.
# AUTH_MAGIC_LINK=true

# Return the magic link in the API response. Defaults to true outside production.
# EXPOSE_MAGIC_LINK=false

# Where `npm run dev:app` proxies /graphql. Default: http://localhost:3005
# EPHEMERIS_SERVER_URL=http://localhost:3005

# Address the dev compose file publishes Postgres on. `npm run db:up` pins the
# local daemon and leaves this at 127.0.0.1; `npm run db:up:lan` runs the same
# file on the docker.lan host and sets this to 0.0.0.0, because the loopback a
# remote daemon binds is that host's and nothing here could reach it. Trusted
# networks only — see .env.local.example for the rest of that setup.
# DEV_BIND=127.0.0.1

# Password for the dev database. Worth setting alongside `npm run db:up:lan`,
# which puts Postgres on the LAN. Default: ephemeris
# POSTGRES_PASSWORD=ephemeris
